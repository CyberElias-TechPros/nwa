{
  "name": "@nwa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint:api ok'",
    "test": "vitest run",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:reset": "node --experimental-strip-types -e \"import('./db/migrate.js').then(async m=>{const {Pool}=require('@neondatabase/serverless');const p=new Pool({connectionString:process.env.DATABASE_URL});await p.query('DROP SCHEMA public CASCADE; CREATE SCHEMA public;');await p.end();}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@nwa/contracts": "workspace:*",
    "@nwa/domain": "workspace:*",
    "hono": "^4.6.8",
    "kysely": "^0.29.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^4.152.0"
  }
}
